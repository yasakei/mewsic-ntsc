use net
use os
use sys
use strings
use arrays
use json
use fmt
use "log.nt"
use "util.nt"
use "state.nt"
use "config.nt"
use "engine.nt"
use "connector.nt"

static const var int web_panel_port = 8999
static const var string web_panel_url = "http://localhost:8999"

class WebRequest {
    var string method
    var string path
    var string body
    fun init() {
        this.method = ""
        this.path = ""
        this.body = ""
    }
}

class WebResponse {
    var int status
    var string reason
    var string content_type
    var string body
    fun init() {
        this.status = 200
        this.reason = "OK"
        this.content_type = "text/plain; charset=utf-8"
        this.body = ""
    }
}

fun web_html(string body) -> WebResponse {
    var response = WebResponse()
    response.content_type = "text/html; charset=utf-8"
    response.body = copy(body)
    return response
}

fun web_json(string body) -> WebResponse {
    var response = WebResponse()
    response.content_type = "application/json; charset=utf-8"
    response.body = copy(body)
    return response
}

fun web_forbidden(string reason_text) -> WebResponse {
    var response = WebResponse()
    response.status = 403
    response.reason = "Forbidden"
    response.body = copy(reason_text)
    return response
}

fun web_not_found() -> WebResponse {
    var response = WebResponse()
    response.status = 404
    response.reason = "Not Found"
    response.body = "not found"
    return response
}

fun web_write(int client, view WebResponse response) {
    var q = strings.from_char_code(13) + strings.from_char_code(10)
    var head = "HTTP/1.1 " + fmt.i64_to_str(response.status) + " " + copy(response.reason) + q
    head = head + "Content-Type: " + copy(response.content_type) + q
    head = head + "Content-Length: " + fmt.i64_to_str(strings.length(copy(response.body))) + q
    head = head + "Connection: close" + q
    head = head + "Cache-Control: no-store" + q + q
    net.send(client, head + copy(response.body))
}

fun web_route(view mut StateAppContext ctx, string method, string path, string body) -> WebResponse {
    if (method == "GET" && path == "/") {
        return web_html(web_panel_html())
    }
    if (method == "GET" && path == "/api/state") {
        return web_json(web_state_json(ctx))
    }
    if (method == "GET" && path == "/api/settings") {
        return web_json(web_settings_json(ctx))
    }
    if (method == "POST" && path == "/api/settings") {
        return web_save_settings(ctx, copy(body))
    }
    if (method == "POST" && path == "/api/validate") {
        return web_validate(copy(body))
    }
    return web_not_found()
}

fun web_start(view mut StateAppContext ctx) -> bool {
    if (ctx.web.running) {
        return true
    }
    quiet [unused_variable] {
        try {
            ctx.web.listener = net.tcp_listen(web_panel_port)
        } catch (e) {
            log_write(copy(ctx.config_dir), "web panel could not listen on " + fmt.i64_to_str(web_panel_port) + ": " + e)
            return false
        }
    }
    if (ctx.web.listener == 0) {
        return false
    }
    ctx.web.running = true
    return true
}

fun web_stop(view mut StateAppContext ctx) {
    if (ctx.web.running) {
        net.close(ctx.web.listener)
        ctx.web.listener = 0
        ctx.web.running = false
    }
}

fun web_port() -> int {
    return web_panel_port
}

fun web_url() -> string {
    return copy(web_panel_url)
}

fun web_poll(view mut StateAppContext ctx, int budget_ms) {
    var budget = 0.0
    budget = budget_ms
    var int client = net.accept_poll(ctx.web.listener, budget)
    if (client == 0) {
        return
    }
    var request = web_read_request(client)
    var method = request.method
    var path = request.path
    var body = request.body
    if (method == "" && path == "") {
        net.close(client)
        return
    }
    web_write(client, web_route(ctx, copy(method), copy(path), copy(body)))
    net.close(client)
}

fun web_read_request(int client) -> WebRequest {
    var request = WebRequest()
    var array[string] lines = arrays.fill("", 0)
    var int header_bytes = 0
    while (header_bytes < 16384) {
        var line = net.recv_line(client)
        if (line == "") {
            break
        }
        arrays.push(lines, copy(line))
        header_bytes = header_bytes + strings.length(copy(line)) + 2
        if (strings.trim(copy(line)) == "") {
            break
        }
    }
    if (arrays.length(lines) == 0) {
        return request
    }
    var first = util_split_all(lines[0], " ")
    if (arrays.length(first) < 2) {
        return request
    }
    request.method = copy(first[0])
    request.path = copy(first[1])
    var int want = web_content_length(lines)
    if (want > 0) {
        var body = net.recv(client, want)
        while (strings.length(copy(body)) < want) {
            var more = net.recv(client, want - strings.length(copy(body)))
            if (more == "") {
                break
            }
            body = body + copy(more)
        }
        request.body = copy(body)
    }
    return request
}

fun web_content_length(view array[string] lines) -> int {
    for (var line in lines) {
        var lower = strings.lower(copy(line))
        var at = strings.index_of(copy(lower), "content-length:", 0)
        if (at < 0) {
            continue
        }
        var value = strings.trim(strings.substring(copy(lower), at + 15, -1))
        if (value == "" || !fmt.is_int(value)) {
            continue
        }
        var n = fmt.to_int(copy(value))
        if (n > 65536) {
            return 65536
        }
        return n
    }
    return 0
}

fun web_panel_html() -> string {
    var path = web_asset_path("panel.html")
    if (!sys_exists(copy(path))) {
        return "<!doctype html><title>mewsic</title><p>panel.html is missing from " + copy(path) + "</p>"
    }
    quiet [unused_variable] {
        try {
            return sys_read(copy(path))
        } catch (e) {
        }
    }
    return "<!doctype html><title>mewsic</title><p>panel.html could not be read</p>"
}

fun web_asset_path(string name) -> string {
    var exe = os_path_dirname(os_executable_path())
    if (exe != "") {
        var next = exe + "/static/" + copy(name)
        if (sys_exists(copy(next))) {
            return copy(next)
        }
    }
    return "static/" + copy(name)
}

fun sys_exists(string path) -> bool {
    return sys.exists(copy(path))
}

fun sys_read(string path) -> string {
    return sys.read(copy(path))
}

fun os_executable_path() -> string {
    return os.executable_path()
}

fun os_path_dirname(string path) -> string {
    return os.path_dirname(copy(path))
}

fun web_state_json(view StateAppContext ctx) -> string {
    var pb = engine_snapshot(ctx)
    var q = util_dquote()
    var text = "{"
    text = text + q + "song" + q + ":" + json.escape_string(pb.song_name)
    text = text + "," + q + "artist" + q + ":" + json.escape_string(pb.song_author)
    text = text + "," + q + "playing" + q + ":" + engine_bool_text(pb.is_playing)
    text = text + "," + q + "progress" + q + ":" + fmt.i64_to_str(pb.song_progress)
    text = text + "," + q + "duration" + q + ":" + fmt.i64_to_str(pb.song_duration)
    text = text + "," + q + "line" + q + ":" + json.escape_string(pb.current_line)
    text = text + "," + q + "hasLyrics" + q + ":" + engine_bool_text(pb.has_lyrics)
    text = text + "," + q + "source" + q + ":" + json.escape_string(engine_last_source(ctx))
    text = text + "," + q + "latency" + q + ":" + fmt.i64_to_str(engine_last_latency(ctx))
    text = text + "," + q + "autooffset" + q + ":" + fmt.i64_to_str(ctx.state.tracker.avg_latency())
    text = text + "," + q + "update" + q + ":{"
    text = text + q + "latest" + q + ":" + json.escape_string(ctx.state.update.latest)
    text = text + "," + q + "message" + q + ":" + json.escape_string(ctx.state.update.message)
    text = text + "}}"
    return text
}

fun web_settings_json(view StateAppContext ctx) -> string {
    var s = ctx.settings
    var q = util_dquote()
    var text = "{"
    text = text + q + "token" + q + ":" + util_dquote()
    text = text + "," + q + "hasToken" + q + ":" + engine_bool_text(s.token != "")
    text = text + "," + q + "source" + q + ":" + fmt.i64_to_str(s.source)
    text = text + "," + q + "lastfm" + q + ":{"
    text = text + q + "api_key" + q + ":" + json.escape_string(s.lastfm.api_key)
    text = text + "," + q + "username" + q + ":" + json.escape_string(s.lastfm.username)
    text = text + "}"
    text = text + "," + q + "view" + q + ":{"
    text = text + q + "timestamp" + q + ":" + engine_bool_text(s.view_settings.timestamp)
    text = text + "," + q + "label" + q + ":" + engine_bool_text(s.view_settings.label)
    text = text + "," + q + "emoji" + q + ":" + json.escape_string(s.view_settings.emoji)
    text = text + "," + q + "auto_clear" + q + ":" + engine_bool_text(s.view_settings.auto_clear)
    text = text + "}"
    text = text + "," + q + "timing" + q + ":{"
    text = text + q + "send_time_offset" + q + ":" + fmt.i64_to_str(s.timing.send_time_offset)
    text = text + "," + q + "enable_autooffset" + q + ":" + engine_bool_text(s.timing.enable_autooffset)
    text = text + "," + q + "autooffset" + q + ":" + fmt.i64_to_str(s.timing.autooffset)
    text = text + "}"
    text = text + "," + q + "lyrics" + q + ":{"
    text = text + q + "romanize" + q + ":" + engine_bool_text(s.lyrics.romanize)
    text = text + "}"
    text = text + "," + q + "update" + q + ":{" + q + "auto_start" + q + ":" + engine_bool_text(s.update.auto_start) + "}"
    text = text + "," + q + "usage" + q + ":{" + q + "enabled" + q + ":" + engine_bool_text(s.usage.enabled) + "}"
    text = text + "}"
    return text
}

fun web_save_settings(view mut StateAppContext ctx, string body) -> WebResponse {
    var s = ctx.settings
    var root = copy(body)
    var token = util_json_string(json.get(copy(root), "token"))
    if (token != "" && token != "null") {
        s.token = copy(token)
    }
    var source = util_json_string(json.get(copy(root), "source"))
    if (source == "lastfm" || source == "1") {
        s.source = ConfigSource.Lastfm
    } else {
        s.source = ConfigSource.Spotify
    }
    var lastfm = json.get(copy(root), "lastfm")
    var api_key = util_json_string(json.get(copy(lastfm), "api_key"))
    if (api_key != "null") {
        s.lastfm.api_key = copy(api_key)
    }
    var username = util_json_string(json.get(copy(lastfm), "username"))
    if (username != "null") {
        s.lastfm.username = copy(username)
    }
    web_apply_view(s, json.get(copy(root), "view"))
    web_apply_timing(s, json.get(copy(root), "timing"))
    web_apply_lyrics(s, json.get(copy(root), "lyrics"))
    web_apply_flags(s, json.get(copy(root), "update"), json.get(copy(root), "usage"))
    var saved = config_save(s, copy(ctx.config_dir))
    if (saved != "") {
        var q = util_dquote()
        return web_json("{" + q + "ok" + q + ":false," + q + "error" + q + ":" + json.escape_string(copy(saved)) + "}")
    }
    var q = util_dquote()
    return web_json("{" + q + "ok" + q + ":true}")
}

fun web_apply_view(view mut ConfigSettings s, string view_json) {
    var emoji = util_json_string(json.get(copy(view_json), "emoji"))
    if (emoji != "null") {
        s.view_settings.emoji = copy(emoji)
    }
    s.view_settings.timestamp = web_bool(json.get(copy(view_json), "timestamp"), s.view_settings.timestamp)
    s.view_settings.label = web_bool(json.get(copy(view_json), "label"), s.view_settings.label)
    s.view_settings.auto_clear = web_bool(json.get(copy(view_json), "auto_clear"), s.view_settings.auto_clear)
}

fun web_apply_timing(view mut ConfigSettings s, string timing_json) {
    var offset = util_json_int(json.get(copy(timing_json), "send_time_offset"), s.timing.send_time_offset)
    s.timing.send_time_offset = offset
    s.timing.enable_autooffset = web_bool(json.get(copy(timing_json), "enable_autooffset"), s.timing.enable_autooffset)
    s.timing.autooffset = util_json_int(json.get(copy(timing_json), "autooffset"), s.timing.autooffset)
}

fun web_apply_lyrics(view mut ConfigSettings s, string lyrics_json) {
    s.lyrics.romanize = web_bool(json.get(copy(lyrics_json), "romanize"), s.lyrics.romanize)
}

fun web_apply_flags(view mut ConfigSettings s, string update_json, string usage_json) {
    s.update.auto_start = web_bool(json.get(copy(update_json), "auto_start"), s.update.auto_start)
    s.usage.enabled = web_bool(json.get(copy(usage_json), "enabled"), s.usage.enabled)
}

fun web_bool(string text, bool current) -> bool {
    if (text == "true") {
        return true
    }
    if (text == "false") {
        return false
    }
    return current
}

fun util_json_int(string text, int current) -> int {
    if (fmt.is_int(copy(text))) {
        return fmt.to_int(copy(text))
    }
    return current
}

fun web_validate(string body) -> WebResponse {
    var token = util_json_string(json.get(copy(body), "token"))
    var valid = false
    if (token != "" && token != "null") {
        valid = connector_validate_token(copy(token))
    }
    var q = util_dquote()
    return web_json("{" + q + "ok" + q + ":" + engine_bool_text(valid) + "}")
}
