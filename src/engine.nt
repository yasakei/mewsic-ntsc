    arrays.push(target, n)
    arrays.push(target, n * 2)
}

fun vm_fill_str(view mut array[string] target, string s) {
    arrays.push(target, s)
}





fun vm_second(view string label, view mut array[int] target, int n) {
    arrays.push(target, n)
}


fun vm_loop_push(view string label, view mut array[int] target, int n) {
    var i = 0
    while (i < n) {
        arrays.push(target, i * 10)
        i = i + 1
    }
}


fun vm_loop_push_ret(view string label, view mut array[int] target, int n) -> string {
    var body = ""
    var i = 0
    while (i < n) {
        arrays.push(target, i * 10)
        body = body + "x"
        i = i + 1
    }
    return body
}


fun vm_loop_push_cont(view string label, view mut array[int] target, int n) -> string {
    var body = ""
    var i = 0
    while (i < n) {
        if (i == 1) {
            i = i + 1
            continue
        }
        arrays.push(target, i * 10)
        body = body + "x"
        i = i + 1
    }
    return body
}








test engine_pause_edge_fires_only_on_the_transition {
    var ctx = engine_test_ctx()
    var tracker = ctx.state.tracker
    var pb = ctx.state.playback
    pb.is_playing = false
    testing.assert_true(!engine_playing_edge_to_pause(tracker, false))
    pb.is_playing = true
    testing.assert_true(!engine_playing_edge_to_pause(tracker, true))
    pb.is_playing = false
    testing.assert_true(engine_playing_edge_to_pause(tracker, false))
    testing.assert_true(!engine_playing_edge_to_pause(tracker, false))
    pb.is_playing = true
    testing.assert_true(!engine_playing_edge_to_pause(tracker, true))
    pb.is_playing = false
    testing.assert_true(engine_playing_edge_to_pause(tracker, false))
}

test engine_never_playing_never_fires {
    var ctx = engine_test_ctx()
    var tracker = ctx.state.tracker
    testing.assert_true(!engine_playing_edge_to_pause(tracker, false))
    testing.assert_true(!engine_playing_edge_to_pause(tracker, false))
}

test engine_sending_a_line_records_last_send {
    var ctx = engine_test_ctx()
    ctx.config_dir = "/tmp/mewsic-engine-test"
    var settings = ctx.settings
    settings.timing.send_time_offset = 0
    settings.timing.enable_autooffset = false
    settings.view_settings.auto_clear = false
    engine_fill_playback(ctx.state.playback, 2000)
    testing.assert_true(ctx.state.tracker.last_send_ms < 0.0)
    var action = engine_maybe_send_line(ctx)
    testing.assert_true(action.kind == "update")
    testing.assert_true(strings.contains(action.text, "hello"))
    testing.assert_true(ctx.state.tracker.last_send_ms >= 0.0)
    testing.assert_true(ctx.state.playback.has_current_line)
    testing.assert_true(ctx.state.playback.current_line.time == 1500)
    testing.assert_true(ctx.state.tracker.sent_lines[0] == 1500)
}

test engine_a_line_is_not_sent_twice {
    var ctx = engine_test_ctx()
    ctx.config_dir = "/tmp/mewsic-engine-test"
    var settings = ctx.settings
    settings.timing.send_time_offset = 0
    settings.timing.enable_autooffset = false
    settings.view_settings.auto_clear = false
    engine_fill_playback(ctx.state.playback, 2000)
    testing.assert_true(engine_maybe_send_line(ctx).kind == "update")
    testing.assert_true(engine_maybe_send_line(ctx).kind == "none")
}

test engine_keep_alive_refreshes_last_send_on_an_expiring_status {
    var ctx = engine_test_ctx()
    ctx.config_dir = "/tmp/mewsic-engine-test"
    engine_fill_playback(ctx.state.playback, 0)
    var line = StateLyricsLine()
    line.time = 9000
    line.text = "still playing"
    ctx.state.playback.current_line = line
    ctx.state.playback.has_current_line = true
    var stale_by = util_trunc(engine_keepalive_interval_ms / 1000) + 10
    ctx.state.tracker.last_send_ms = time.now() / 1000.0 - stale_by

    var action = engine_maybe_keep_alive(ctx)
    testing.assert_true(action.kind == "keepalive")
    testing.assert_true(action.text != "")
    var elapsed = util_trunc(time.now() / 1000.0 - ctx.state.tracker.last_send_ms)
    testing.assert_true(elapsed < 1000)
}

test engine_keep_alive_skips_within_the_refresh_window {
    var ctx = engine_test_ctx()
    ctx.config_dir = "/tmp/mewsic-engine-test"
    engine_fill_playback(ctx.state.playback, 0)
    var line = StateLyricsLine()
    line.time = 9000
    line.text = "still playing"
    ctx.state.playback.current_line = line
    ctx.state.playback.has_current_line = true
    var before = time.now() / 1000.0 - 5.0
    ctx.state.tracker.last_send_ms = before
    testing.assert_true(engine_maybe_keep_alive(ctx).kind == "none")
    testing.assert_true(ctx.state.tracker.last_send_ms == before)
}

test engine_pick_line_chooses_the_last_line_before_the_threshold {
    var array[int] times = arrays.fill(0, 0)
    var array[string] texts = arrays.fill("", 0)
    arrays.push(times, 1000)
    arrays.push(texts, "one")
    arrays.push(times, 2000)
    arrays.push(texts, "two")
    arrays.push(times, 3000)
    arrays.push(texts, "three")
    var ctx = engine_test_ctx()
    var tracker = ctx.state.tracker
    var pb = ctx.state.playback
    testing.assert_true(engine_pick_line(times, texts, 2500, tracker, pb) == 1)
    testing.assert_true(engine_pick_line(times, texts, 1000, tracker, pb) == -1)
    testing.assert_true(engine_pick_line(times, texts, 4000, tracker, pb) == 2)
}

test engine_pick_line_skips_empty_and_sent_lines {
    var array[int] times = arrays.fill(0, 0)
    var array[string] texts = arrays.fill("", 0)
    arrays.push(times, 1000)
    arrays.push(texts, "   ")
    arrays.push(times, 2000)
    arrays.push(texts, "sent")
    arrays.push(times, 3000)
    arrays.push(texts, "fresh")
    var ctx = engine_test_ctx()
    var tracker = ctx.state.tracker
    var pb = ctx.state.playback
    arrays.push(tracker.sent_lines, 2000)
    testing.assert_true(engine_pick_line(times, texts, 2500, tracker, pb) == -1)
    testing.assert_true(engine_pick_line(times, texts, 3500, tracker, pb) == 2)
}

test engine_offset_uses_measured_latency_when_autooffset_is_on {
    var settings = ConfigSettings()
    var tracker = StateTracker()
    settings.timing.enable_autooffset = false
    settings.timing.send_time_offset = 500
    testing.assert_true(engine_offset(settings, tracker) == 500)
    settings.timing.enable_autooffset = true
    tracker.add_latency(200, 3)
    tracker.add_latency(400, 3)
    testing.assert_true(engine_offset(settings, tracker) == 300 + 100)
}

test engine_offset_falls_back_to_the_default_lastfm_lag {
    var settings = ConfigSettings()
    var tracker = StateTracker()
    settings.source = ConfigSource.Lastfm
    settings.timing.enable_autooffset = false
    settings.timing.send_time_offset = 200
    testing.assert_true(engine_offset(settings, tracker) == engine_default_lastfm_lag_ms + 200)
    tracker.lastfm_lag = 7000
    testing.assert_true(engine_offset(settings, tracker) == 7200)
}

test engine_apply_state_reports_the_song_change {
    var ctx = engine_test_ctx()
    var state = PlayerState()
    state.is_playing = true
    state.duration_ms = 240000
    state.track_id = "track-1"
    state.name = "Song (Live)"
    state.artist = "Artist"
    testing.assert_true(engine_apply_state(ctx, state, true, 4200))
    var pb = ctx.state.playback
    testing.assert_true(pb.song_id == "track-1")
    testing.assert_true(pb.song_name == "Song")
    testing.assert_true(pb.song_author == "Artist")
    testing.assert_true(pb.song_progress == 4200)
    testing.assert_true(pb.song_duration == 240000)
    testing.assert_true(!engine_apply_state(ctx, state, false, 0))
}

test a_later_poll_keeps_the_lyrics_of_the_track_it_reports {
    var ctx = engine_test_ctx()
    var state = PlayerState()
    state.is_playing = true
    state.duration_ms = 240000
    state.track_id = "track-1"
    state.name = "Song"
    state.artist = "Artist"
    engine_apply_state(ctx, state, true, 4200)
    ctx.settings.view_settings.auto_clear = false
    var q = util_dquote()
    var lines = "[{" + q + "time" + q + ":1000," + q + "text" + q + ":" + q + "hello" + q + "}]"
    engine_apply_lyrics(ctx, engine_lyrics_message("Song", "Artist", true, "LrcLib", lines))
    testing.assert_true(ctx.state.playback.has_lyrics)

    engine_apply_state(ctx, state, true, 5200)
    testing.assert_true(ctx.state.playback.has_lyrics)
    testing.assert_true(arrays.length(ctx.state.playback.lyric_times) == 1)
    testing.assert_true(ctx.state.playback.song_progress == 5200)

    var action = engine_maybe_send_line(ctx)
    testing.assert_true(action.kind == "update")
    testing.assert_true(ctx.state.playback.has_current_line)
    testing.assert_true(ctx.state.playback.current_line.text == "hello")
}

test engine_tick_clears_sent_lines_when_the_song_ends {
    var ctx = engine_test_ctx()
    var pb = ctx.state.playback
    pb.is_playing = true
    pb.song_duration = 1000
    pb.song_progress = 500
    arrays.push(ctx.state.tracker.sent_lines, 400)
    var action = EngineAction()
    engine_tick(ctx, 600, action)
    testing.assert_true(arrays.length(ctx.state.tracker.sent_lines) == 0)
}

test engine_effective_limit_is_at_least_one {
    testing.assert_true(engine_effective_limit(0) == 1)
    testing.assert_true(engine_effective_limit(-5) == 1)
    testing.assert_true(engine_effective_limit(3) == 3)
}

test engine_action_round_trips_through_json {
    var action = engine_action("update", "line \"one\"", "🎧")
    var encoded = engine_encode_action(action)
    testing.assert_true(json.is_valid(copy(encoded)))
    testing.assert_true(util_json_string(json.get(copy(encoded), "kind")) == "update")
    testing.assert_true(util_json_string(json.get(copy(encoded), "text")) == "line \"one\"")
    testing.assert_true(util_json_string(json.get(copy(encoded), "emoji")) == "🎧")
}

test engine_messages_are_valid_json {
    testing.assert_true(json.is_valid(engine_log_message("hi")))
    testing.assert_true(json.is_valid(engine_lag_message(1200)))
    testing.assert_true(json.is_valid(engine_lyrics_request("S", "A")))
    testing.assert_true(util_json_string(json.get(engine_lyrics_request("S", "A"), "kind")) == "lyrics_request")
    testing.assert_true(json.is_valid(engine_lyrics_message("S", "A", true, "LrcLib", "[]")))
    testing.assert_true(json.is_valid(engine_state_message("state", "t", "S", "A", 10, true, 20)))
}

test engine_apply_update_reads_a_polled_state {
    var ctx = engine_test_ctx()
    var message = engine_state_message("state", "t1", "Song (Live)", "Artist", 4200, true, 240000)
    testing.assert_true(engine_apply_update(ctx, message))
    var pb = ctx.state.playback
    testing.assert_true(pb.song_id == "t1")
    testing.assert_true(pb.song_name == "Song")
    testing.assert_true(pb.song_progress == 4200)
    testing.assert_true(pb.is_playing)
    testing.assert_true(pb.song_duration == 240000)
}

test engine_apply_update_records_latency_and_lag {
    var ctx = engine_test_ctx()
    ctx.settings.timing.autooffset = 3
    testing.assert_true(!engine_apply_update(ctx, engine_lag_message(4200)))
    testing.assert_true(ctx.state.tracker.lastfm_lag == 4200)
    var string q = util_dquote()
    var latency = "{" + q + "kind" + q + ":" + q + "latency" + q + "," + q + "ms" + q + ":250}"
    engine_apply_update(ctx, copy(latency))
    testing.assert_true(ctx.state.tracker.last_latency == 250)
    testing.assert_true(ctx.state.tracker.avg_latency() == 250)
}

test engine_apply_update_marks_stopped_and_logs {
    var ctx = engine_test_ctx()
    ctx.state.playback.is_playing = true
    testing.assert_true(!engine_apply_update(ctx, engine_state_message("stopped", "", "", "", 0, false, 0)))
    testing.assert_true(!ctx.state.playback.is_playing)

    ctx.config_dir = "/tmp/mewsic-engine-log"
    sys.mkdir(ctx.config_dir)
    engine_apply_update(ctx, engine_log_message("hello"))
    var raw = sys.read(ctx.config_dir + "/log.txt")
    testing.assert_true(strings.contains(copy(raw), "hello"))
    sys.rm(ctx.config_dir + "/log.txt")
}

test engine_apply_update_handles_lyrics_messages {
    var ctx = engine_test_ctx()
    var q = util_dquote()
    var lines = "[{" + q + "time" + q + ":1000," + q + "text" + q + ":" + q + "hello" + q + "}]"
    engine_apply_update(ctx, engine_lyrics_message("S", "A", true, "LrcLib", lines))
    testing.assert_true(ctx.state.playback.has_lyrics)
    testing.assert_true(ctx.state.lyric_source == "LrcLib")
    testing.assert_true(arrays.length(ctx.state.playback.lyric_times) == 1)
    testing.assert_true(ctx.state.playback.lyric_times[0] == 1000)
    testing.assert_true(ctx.state.playback.lyric_texts[0] == "hello")

    engine_apply_update(ctx, engine_lyrics_message("S", "A", false, "none", "[]"))
    testing.assert_true(ctx.state.playback.has_lyrics)
    testing.assert_true(ctx.state.lyric_source == "LrcLib")
    testing.assert_true(arrays.length(ctx.state.playback.lyric_times) == 1)

    var ctx2 = engine_test_ctx()
    engine_apply_update(ctx2, engine_lyrics_message("S", "A", false, "none", "[]"))
    testing.assert_true(!ctx2.state.playback.has_lyrics)
    testing.assert_true(ctx2.state.lyric_source == "none")
}

test engine_push_status_without_a_token_does_nothing {
    var state = EngineStatusState()
    state.token = ""
    var report = engine_push_status(state, engine_encode_action(engine_action("update", "line", "")))
    testing.assert_true(report == "")
    testing.assert_true(!state.has_original)
}

test engine_restore_status_is_a_no_op_without_a_capture {
    var state = EngineStatusState()
    state.has_original = false
    engine_restore_status(state)
    testing.assert_true(!state.has_original)
}

test view_mut_array_param_shares_the_caller_array {
    var array[int] xs = arrays.fill(0, 0)
    vm_fill(xs, 7)
    testing.assert_true(arrays.length(xs) == 2)
    testing.assert_true(xs[0] == 7)
    testing.assert_true(xs[1] == 14)
}

test view_mut_string_array_param_shares_the_caller_array {
    var array[string] ss = arrays.fill("", 0)
    vm_fill_str(ss, "hi")
    testing.assert_true(arrays.length(ss) == 1)
    testing.assert_true(ss[0] == "hi")
}

test arrays_clear_empties_the_caller_array {
    var array[int] xs = arrays.fill(0, 0)
    arrays.push(xs, 1)
    arrays.push(xs, 2)
    testing.assert_true(arrays.length(xs) == 2)
    arrays.clear(xs)
    testing.assert_true(arrays.length(xs) == 0)
}

test arrays_clear_empties_a_string_array {
    var array[string] ss = arrays.fill("", 0)
    arrays.push(ss, "a")
    testing.assert_true(arrays.length(ss) == 1)
    arrays.clear(ss)
    testing.assert_true(arrays.length(ss) == 0)
}

test view_mut_array_param_in_a_later_position_still_shares {
    var array[int] xs = arrays.fill(0, 0)
    vm_second("x", xs, 5)
    testing.assert_true(arrays.length(xs) == 1)
    testing.assert_true(xs[0] == 5)
}

test view_mut_param_push_in_callee_loop {
    var array[int] xs = arrays.fill(0, 0)
    vm_loop_push("x", xs, 3)
    testing.assert_true(arrays.length(xs) == 3)
    testing.assert_true(xs[0] == 0)
    testing.assert_true(xs[2] == 20)
}

test view_mut_param_push_in_callee_loop_with_return {
    var array[int] xs = arrays.fill(0, 0)
    var body = vm_loop_push_ret("hello", xs, 3)
    testing.assert_true(body == "xxx")
    testing.assert_true(arrays.length(xs) == 3)
    testing.assert_true(xs[2] == 20)
}

test view_mut_param_push_with_continue {
    var array[int] xs = arrays.fill(0, 0)
    var body = vm_loop_push_cont("hello", xs, 3)
    testing.assert_true(body == "xx")
    testing.assert_true(arrays.length(xs) == 2)
    testing.assert_true(xs[1] == 20)
}

test arrays_clear_then_push_reuses_the_array {
    var array[int] xs = arrays.fill(0, 0)
    arrays.push(xs, 1)
    arrays.clear(xs)
    arrays.push(xs, 9)
    testing.assert_true(arrays.length(xs) == 1)
    testing.assert_true(xs[0] == 9)
}

test arrays_clear_empties_readable_contents {
    var array[int] xs = arrays.fill(0, 0)
    arrays.push(xs, 1)
    arrays.push(xs, 2)
    arrays.clear(xs)
    testing.assert_true(arrays.length(xs) == 0)
}

test lyrics_cache_hit_stores_lines_for_playback {
    var ctx = engine_test_ctx()
    ctx.config_dir = "/home/yasakei/.config/mewsic"
    var poller = EnginePoller()
    poller.fetcher = lyrics_fetcher_new(copy(ctx.config_dir))
    var answer = engine_answer_lyrics_request(poller, engine_lyrics_request("What You Know", "Two Door Cinema Club"))
    engine_apply_lyrics(ctx, copy(answer))
    testing.assert_true(ctx.state.playback.has_lyrics)
    testing.assert_true(arrays.length(ctx.state.playback.lyric_times) > 0)
}
