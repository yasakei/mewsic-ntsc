use sys
use os
use strings
use testing
use @keyring
use "log.nt"

fun credential_store_token(string dir, string token) -> string {
    quiet [unused_variable] {
        try {
            @keyring.Entry_set_password(credential_entry(), token)
            try {
                sys.rm(dir + "/token")
            } catch (e) {
            }
            return ""
        } catch (e) {
            return credential_fallback_store(dir, token)
        }
    }
}

fun credential_load_token(string dir) -> string {
    quiet [unused_variable] {
        try {
            return @keyring.Entry_get_password(credential_entry())
        } catch (e) {
        }
    }
    return credential_fallback_load(dir)
}

fun credential_clear_token(string dir) {
    quiet [unused_variable] {
        try {
            @keyring.Entry_delete_credential(credential_entry())
        } catch (e) {
        }
    }
    quiet [unused_variable] {
        try {
            sys.rm(dir + "/token")
        } catch (e) {
        }
    }
}

fun credential_entry() -> int {
    var service = os.getenv("MEWSIC_KEYRING_SERVICE")
    if (service == "") {
        service = "mewsic"
    }
    var user = os.getenv("MEWSIC_KEYRING_USER")
    if (user == "") {
        user = "discord-token"
    }
    return @keyring.Entry_new(service, user)
}

fun credential_fallback_store(string dir, string token) -> string {
    sys.mkdir(dir)
    try {
        sys.write(dir + "/token", token)
    } catch (e) {
        return "cannot write token file: " + e
    }
    sys.exec("chmod 600 '" + dir + "/token' 2>/dev/null")
    return ""
}

fun credential_fallback_load(string dir) -> string {
    var raw = ""
    quiet [unused_variable] {
        try {
            raw = sys.read(dir + "/token")
        } catch (e) {
            return ""
        }
    }
    return strings.trim(raw)
}

fun credential_fallback_clear(string dir) {
    quiet [unused_variable] {
        try {
            sys.rm(dir + "/token")
        } catch (e) {
        }
    }
}

test credential_fallback_roundtrip {
    var dir = "/tmp/mewsic-cred-test"
    sys.mkdir(copy(dir))
    var r = credential_fallback_store(copy(dir), "super-secret")
    testing.assert_true(r == "")
    testing.assert_true(credential_fallback_load(copy(dir)) == "super-secret")
    credential_fallback_clear(copy(dir))
    testing.assert_true(credential_fallback_load(dir) == "")
}
