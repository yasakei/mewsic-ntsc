test probe_loretta_cache {
    var fetcher = lyrics_fetcher_new("/home/yasakei/.config/mewsic")
    var lines = lyrics_read_cache(fetcher, "Loretta", "Ginger Root", false)
    say("loretta-lines=" + fmt.i64_to_str(arrays.length(lines)))
