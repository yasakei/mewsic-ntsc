fun bntomew_is_bengali(view string ch) -> bool {
    var code = translit_codepoint(ch)
    return code >= 2432 && code <= 2559
}

fun bntomew_is_word_start(view array[string] chars, int at) -> bool {
    if (at == 0) {
        return true
    }
    return !bntomew_is_bengali(chars[at - 1])
}

fun bntomew_fill_lexicon(view mut array[string] keys, view mut array[string] values) {
    var newline = strings.from_char_code(10)
    var total = strings.length(bntomew_lexicon_data)
    var start = 0
    while (start < total) {
        var end = strings.index_of(bntomew_lexicon_data, newline, start)
        if (end == -1) {
            end = total
        }
        var separator = strings.index_of(bntomew_lexicon_data, "|", start)
        if (separator > start && separator < end) {
            arrays.push(keys, strings.substring(bntomew_lexicon_data, start, separator))
            arrays.push(values, strings.substring(bntomew_lexicon_data, separator + 1, end))
        }
        if (end == total) {
            break
        }
        start = end + 1
    }
}

fun bntomew_chars_append(view array[string] chars, int start, int end) -> string {
    var out = ""
    var i = start
    while (i < end) {
        out = out + chars[i]
        i = i + 1
    }
    return out
}

fun bntomew_match_len(view array[string] chars, int start, view string wanted) -> int {
    var array[string] wanted_chars = translit_chars(wanted)
    var count = arrays.length(wanted_chars)
    if (start + count > arrays.length(chars)) {
        return -1
    }
    var i = 0
    while (i < count) {
        if (chars[start + i] != wanted_chars[i]) {
            return -1
        }
        i = i + 1
    }
    if (count == 0) {
        return -1
    }
    return count
}

fun bntomew_lexicon_at(view array[string] chars, int start, view array[string] keys, view array[string] values) -> (bool, int, string) {
    var i = 0
    while (i < arrays.length(keys)) {
        var length = bntomew_match_len(chars, start, keys[i])
        if (length >= 0) {
            var base_end = start + length
            var suffix = ""
            var suffix_romanized = ""

            if (bntomew_match_len(chars, base_end, "এর") >= 0) {
                suffix = "এর"
                suffix_romanized = "er"
            } else if (bntomew_match_len(chars, base_end, "ের") >= 0) {
                suffix = "ের"
                suffix_romanized = "er"
            } else if (bntomew_match_len(chars, base_end, "র") >= 0) {
                suffix = "র"
                suffix_romanized = "r"
            } else if (bntomew_match_len(chars, base_end, "তে") >= 0) {
                suffix = "তে"
                suffix_romanized = "te"
            } else if (bntomew_match_len(chars, base_end, "য়") >= 0) {
                suffix = "য়"
                suffix_romanized = "y"
            } else if (bntomew_match_len(chars, base_end, "কে") >= 0) {
                suffix = "কে"
                suffix_romanized = "ke"
            } else if (bntomew_match_len(chars, base_end, "ও") >= 0) {
                suffix = "ও"
                suffix_romanized = "o"
            } else if (bntomew_match_len(chars, base_end, "ই") >= 0) {
                suffix = "ই"
                suffix_romanized = "i"
            } else if (bntomew_match_len(chars, base_end, "গুলো") >= 0) {
                suffix = "গুলো"
                suffix_romanized = "gulo"
            } else if (bntomew_match_len(chars, base_end, "রা") >= 0) {
                suffix = "রা"
                suffix_romanized = "ra"
            }

            if (suffix != "") {
                var suffix_length = translit_chars(suffix)
                var suffix_end = base_end + arrays.length(suffix_length)
                if (suffix_end >= arrays.length(chars) || !bntomew_is_bengali(chars[suffix_end])) {
                    return (true, suffix_end, copy(values[i]) + suffix_romanized)
                }
            }

            if (base_end >= arrays.length(chars) || !bntomew_is_bengali(chars[base_end])) {
                return (true, base_end, copy(values[i]))
            }
        }
        i = i + 1
    }
    return (false, start, "")
}

fun bntomew_consonant(view string ch) -> string {
    var code = translit_codepoint(ch)
    if (code == 2453) { return "k" }
    if (code == 2454) { return "kh" }
    if (code == 2455) { return "g" }
    if (code == 2456) { return "gh" }
    if (code == 2457) { return "ng" }
    if (code == 2458) { return "ch" }
    if (code == 2459) { return "ch" }
    if (code == 2460) { return "j" }
    if (code == 2461) { return "jh" }
    if (code == 2462) { return "n" }
    if (code == 2463) { return "t" }
    if (code == 2464) { return "th" }
    if (code == 2465) { return "d" }
    if (code == 2466) { return "dh" }
    if (code == 2467) { return "n" }
    if (code == 2468) { return "t" }
    if (code == 2469) { return "th" }
    if (code == 2470) { return "d" }
    if (code == 2471) { return "dh" }
    if (code == 2472) { return "n" }
    if (code == 2474) { return "p" }
    if (code == 2475) { return "f" }
    if (code == 2476) { return "b" }
    if (code == 2477) { return "bh" }
    if (code == 2478) { return "m" }
    if (code == 2479) { return "j" }
    if (code == 2480) { return "r" }
    if (code == 2482) { return "l" }
    if (code == 2486) { return "sh" }
    if (code == 2487) { return "sh" }
    if (code == 2488) { return "s" }
    if (code == 2489) { return "h" }
    if (code == 2524) { return "r" }
    if (code == 2525) { return "rh" }
    if (code == 2527) { return "y" }
    if (code == 2510) { return "t" }
    return ""
}

fun bntomew_independent(view string ch) -> string {
    var code = translit_codepoint(ch)
    if (code == 2437) { return "o" }
    if (code == 2438) { return "a" }
    if (code == 2439 || code == 2440) { return "i" }
    if (code == 2441 || code == 2442) { return "u" }
    if (code == 2443) { return "ri" }
    if (code == 2447) { return "e" }
    if (code == 2448) { return "oi" }
    if (code == 2451) { return "o" }
    if (code == 2452) { return "ou" }
    if (code == 2511) { return "e" }
    return ""
}

fun bntomew_matra(view string ch) -> string {
    var code = translit_codepoint(ch)
    if (code == 2494) { return "a" }
    if (code == 2495 || code == 2496) { return "i" }
    if (code == 2497 || code == 2498) { return "u" }
    if (code == 2499) { return "ri" }
    if (code == 2503) { return "e" }
    if (code == 2504) { return "oi" }
    if (code == 2507) { return "o" }
    if (code == 2508) { return "ou" }
    return ""
}

fun bntomew_digit(view string ch) -> string {
    var code = translit_codepoint(ch)
    if (code < 2534 || code > 2543) {
        return ""
    }
    return translit_from_codepoint(48 + code - 2534)
}

fun bntomew_double(view string ch) -> string {
    var code = translit_codepoint(ch)
    if (code == 2453) { return "kk" }
    if (code == 2454) { return "kkh" }
    if (code == 2455) { return "gg" }
    if (code == 2456) { return "ggh" }
    if (code == 2458) { return "chch" }
    if (code == 2459) { return "chchh" }
    if (code == 2460) { return "jj" }
    if (code == 2461) { return "jjh" }
    if (code == 2463) { return "tt" }
    if (code == 2464) { return "tth" }
    if (code == 2465) { return "dd" }
    if (code == 2466) { return "ddh" }
    if (code == 2468) { return "tt" }
    if (code == 2469) { return "tth" }
    if (code == 2470) { return "dd" }
    if (code == 2471) { return "ddh" }
    if (code == 2472) { return "nn" }
    if (code == 2474) { return "pp" }
    if (code == 2475) { return "ff" }
    if (code == 2476) { return "bb" }
    if (code == 2477) { return "bbh" }
    if (code == 2478) { return "mm" }
    if (code == 2480) { return "rr" }
    if (code == 2482) { return "ll" }
    if (code == 2486 || code == 2487) { return "shsh" }
    if (code == 2488) { return "ss" }
    if (code == 2489) { return "hh" }
    return ""
}

fun bntomew_conjunct(view array[string] elems, int start, int count) -> string {
    if (count == 0) {
        return ""
    }
    view var first = elems[start]
    if (count == 1) {
        return bntomew_consonant(first)
    }
    view var last = elems[start + 2 * (count - 1)]
    var first_code = translit_codepoint(first)
    var last_code = translit_codepoint(last)

    if (last_code == 2476 && count == 2) {
        if (first_code == 2488) {
            return "sh"
        }
        var doubled = bntomew_double(first)
        if (doubled != "") {
            return doubled
        }
        return bntomew_consonant(first) + "b"
    }
    if (last_code == 2478) {
        var doubled = bntomew_double(first)
        if (doubled != "") {
            return doubled
        }
    }
    if (last_code == 2527 || (last_code == 2479 && count == 2)) {
        var doubled = bntomew_double(first)
        if (doubled != "") {
            return doubled
        }
    }
    if (count == 2 && first_code == 2458 && last_code == 2459) {
        return "cch"
    }

    var out = ""
    var i = 0
    while (i < count) {
        out = out + bntomew_consonant(elems[start + 2 * i])
        i = i + 1
    }
    return out
}

fun bntomew_inherent_mid(view string ch) -> string {
    var code = translit_codepoint(ch)
    if (code == 2457 || code == 2486) {
        return "a"
    }
    return "o"
}

fun bntomew_shape_has_vowel(view array[int] kinds, view array[string] vowels, int at) -> bool {
    return kinds[at] == 0 || (kinds[at] == 2 && vowels[at] != "")
}

fun bntomew_render(view array[string] chars, int start, int end) -> string {
    var array[int] kinds = arrays.fill(0, 0)
    var array[string] texts = arrays.fill("", 0)
    var array[string] element_chars = arrays.fill("", 0)
    var i = start
    while (i < end) {
        view var ch = chars[i]
        var consonant = bntomew_consonant(ch)
        var matra = bntomew_matra(ch)
        var independent = bntomew_independent(ch)
        var digit = bntomew_digit(ch)
        var code = translit_codepoint(ch)
        var consumed_nukta = false
        if (i + 1 < end && translit_codepoint(chars[i + 1]) == 2492) {
            if (code == 2465) { consonant = "r"; consumed_nukta = true }
            if (code == 2466) { consonant = "rh"; consumed_nukta = true }
            if (code == 2479) { consonant = "y"; consumed_nukta = true }
        }
        if (consonant != "") {
            arrays.push(kinds, 0)
            arrays.push(texts, consonant)
            arrays.push(element_chars, ch)
        } else if (code == 2509) {
            arrays.push(kinds, 1)
            arrays.push(texts, "")
            arrays.push(element_chars, ch)
        } else if (matra != "") {
            arrays.push(kinds, 2)
            arrays.push(texts, matra)
            arrays.push(element_chars, ch)
        } else if (independent != "") {
            arrays.push(kinds, 3)
            arrays.push(texts, independent)
            arrays.push(element_chars, ch)
        } else if (code == 2434) {
            arrays.push(kinds, 4)
            arrays.push(texts, "")
            arrays.push(element_chars, ch)
        } else if (code == 2433) {
            arrays.push(kinds, 5)
            arrays.push(texts, "")
            arrays.push(element_chars, ch)
        } else if (code == 2435) {
            arrays.push(kinds, 6)
            arrays.push(texts, "")
            arrays.push(element_chars, ch)
        } else if (digit != "") {
            arrays.push(kinds, 7)
            arrays.push(texts, digit)
            arrays.push(element_chars, ch)
        } else {
            arrays.push(kinds, 8)
            arrays.push(texts, ch)
            arrays.push(element_chars, ch)
        }
        i = i + 1
        if (consumed_nukta) { i = i + 1 }
    }

    var array[string] bases = arrays.fill("", 0)
    var array[string] vowels = arrays.fill("", 0)
    var array[string] heads = arrays.fill("", 0)
    var array[string] tails = arrays.fill("", 0)
    var array[int] shape_kinds = arrays.fill(0, 0)
    var array[bool] conjuncts = arrays.fill(false, 0)
    var count = arrays.length(kinds)
    i = 0
    while (i < count) {
        if (kinds[i] == 0) {
            var cluster_start = i
            var consonant_count = 0
            var j = i
            while (j < count && kinds[j] == 0) {
                consonant_count = consonant_count + 1
                j = j + 1
                if (j < count && kinds[j] == 1 && j + 1 < count && kinds[j + 1] == 0) {
                    j = j + 1
                } else {
                    break
                }
            }
            var dead = j < count && kinds[j] == 1
            var explicit = ""
            var has_explicit = false
            if (j < count && kinds[j] == 2) {
                explicit = copy(texts[j])
                has_explicit = true
            }
            var base = bntomew_conjunct(element_chars, cluster_start, consonant_count)
            if (consonant_count == 1) { base = copy(texts[cluster_start]) }
            arrays.push(bases, base)
            arrays.push(vowels, explicit)
            arrays.push(heads, element_chars[cluster_start])
            arrays.push(tails, "")
            if (!dead && !has_explicit) {
                arrays.push(shape_kinds, 0)
            } else {
                arrays.push(shape_kinds, 1)
            }
            if (has_explicit) {
                shape_kinds[arrays.length(shape_kinds) - 1] = 2
            }
            arrays.push(conjuncts, consonant_count > 1)

            var k = j
            if (has_explicit || dead) {
                k = k + 1
            }
            while (k < count) {
                if (kinds[k] == 4) {
                    tails[arrays.length(tails) - 1] = tails[arrays.length(tails) - 1] + "ng"
                } else if (kinds[k] == 5 || kinds[k] == 6) {
                } else {
                    break
                }
                k = k + 1
            }
            i = k
            continue
        }

        if (kinds[i] == 3 || kinds[i] == 2) {
            arrays.push(bases, "")
            arrays.push(vowels, texts[i])
            arrays.push(heads, "")
            arrays.push(tails, "")
            arrays.push(shape_kinds, 2)
            arrays.push(conjuncts, false)
        } else if (kinds[i] == 7) {
            arrays.push(bases, "")
            arrays.push(vowels, "")
            arrays.push(heads, "")
            arrays.push(tails, texts[i])
            arrays.push(shape_kinds, 1)
            arrays.push(conjuncts, false)
        } else if (kinds[i] == 8) {
            arrays.push(bases, texts[i])
            arrays.push(vowels, "")
            arrays.push(heads, "")
            arrays.push(tails, "")
            arrays.push(shape_kinds, 1)
            arrays.push(conjuncts, false)
        }
        i = i + 1
    }

    var shape_count = arrays.length(bases)
    var last_significant = shape_count - 1
    while (last_significant > 0 && bases[last_significant] == "" && shape_kinds[last_significant] != 0 && vowels[last_significant] == "") {
        last_significant = last_significant - 1
    }
    var protect_from_left = false
    i = last_significant
    while (i >= 0) {
        if (shape_kinds[i] != 0) {
            protect_from_left = false
            i = i - 1
            continue
        }
        var delete_vowel = false
        if (i == last_significant) {
            if (conjuncts[i]) {
                delete_vowel = false
            } else {
                var head_code = translit_codepoint(heads[i])
                var keep_final = (head_code == 2482 || head_code == 2463 || head_code == 2468 || head_code == 2524 || head_code == 2525) && shape_count == 2
                delete_vowel = !keep_final
            }
        } else if (!protect_from_left) {
            var left_vowel = i > 0 && bntomew_shape_has_vowel(shape_kinds, vowels, i - 1)
            var right_vowel = i + 1 < shape_count && bntomew_shape_has_vowel(shape_kinds, vowels, i + 1)
            if (left_vowel && right_vowel) {
                var this_code = translit_codepoint(heads[i])
                var next_code = translit_codepoint(heads[i + 1])
                var rhotic = this_code == 2480 || this_code == 2524 || this_code == 2525
                var next_retroflex = next_code == 2463 || next_code == 2464 || next_code == 2465 || next_code == 2466 || next_code == 2467 || next_code == 2524 || next_code == 2525
                if (!rhotic && !next_retroflex) {
                    delete_vowel = true
                }
            }
        }
        if (delete_vowel) {
            shape_kinds[i] = 2
            vowels[i] = ""
            protect_from_left = true
        } else {
            protect_from_left = false
        }
        i = i - 1
    }

    var out = ""
    i = 0
    while (i < shape_count) {
        out = out + bases[i]
        if (shape_kinds[i] == 2) {
            out = out + vowels[i]
        } else if (shape_kinds[i] == 0) {
            out = out + bntomew_inherent_mid(heads[i])
        }
        out = out + tails[i]
        i = i + 1
    }
    return out
}

fun bntomew_add_romanized(view string out, view string piece) -> string {
    if (piece == "") {
        return copy(out)
    }
    if (strings.starts_with(piece, " ") && strings.ends_with(out, " ")) {
        return copy(out) + strings.substring(piece, 1, -1)
    }
    return copy(out) + copy(piece)
}

fun bntomew_add_space(view string out) -> string {
    if (strings.ends_with(out, " ")) {
        return copy(out)
    }
    return copy(out) + " "
}

fun bntomew_transliterate(view string text) -> BntomewTranslitResult {
    var array[string] keys = arrays.fill("", 0)
    var array[string] values = arrays.fill("", 0)
    bntomew_fill_lexicon(keys, values)

    var array[string] chars = translit_chars(text)
    var bengali = ""
    var romanized = ""
    var i = 0
    while (i < arrays.length(chars)) {
        view var ch = chars[i]
        var code = translit_codepoint(ch)
        if (code == 8204 || code == 8205) {
            i = i + 1
            continue
        }

        if (bntomew_is_word_start(chars, i)) {
            var (found, lexicon_end, lexicon_romanized) = bntomew_lexicon_at(chars, i, keys, values)
            if (found) {
                bengali = bengali + bntomew_chars_append(chars, i, lexicon_end)
                romanized = bntomew_add_romanized(romanized, lexicon_romanized)
                i = lexicon_end
                continue
            }
        }

        if (bntomew_is_bengali(ch)) {
            var word_start = i
            while (i < arrays.length(chars) && bntomew_is_bengali(chars[i])) {
                i = i + 1
            }
            bengali = bengali + bntomew_chars_append(chars, word_start, i)
            romanized = bntomew_add_romanized(romanized, bntomew_render(chars, word_start, i))
            continue
        }

        bengali = bengali + copy(ch)
        if (code == 2404 || code == 2405) {
            romanized = romanized + "."
        } else if (translit_is_space(ch)) {
            romanized = bntomew_add_space(romanized)
        } else if (code != 2509) {
            romanized = romanized + copy(ch)
        }
        i = i + 1
    }

    romanized = strings.trim(romanized)
    return BntomewTranslitResult(bengali, romanized)
}

fun bntomew_romanize(view string text) -> string {
    var translit_result = bntomew_transliterate(text)
    var output = copy(translit_result.romanized)
    return output
}


test bntomew_borrowed_words {
    testing.assert_eq(bntomew_romanize("টেবিল"), "table")
    testing.assert_eq(bntomew_romanize("স্কুল"), "school")
    testing.assert_eq(bntomew_romanize("চেয়ার"), "chair")
}

test bntomew_simple_words {
    testing.assert_eq(bntomew_romanize("বাংলা"), "bangla")
    testing.assert_eq(bntomew_romanize("আমার"), "amar")
    testing.assert_eq(bntomew_romanize("ধন্যবাদ"), "dhonnobad")
    testing.assert_eq(bntomew_romanize("ভালোবাসা"), "bhalobasha")
    testing.assert_eq(bntomew_romanize("শব্দ"), "shobdo")
    testing.assert_eq(bntomew_romanize("বাংলাদেশ"), "bangladesh")
}

test bntomew_sentence_and_result {
    var text = "বাংলাদেশ দক্ষিণ এশিয়ার একটি স্বাধীন সার্বভৌম রাষ্ট্র।"
    var translit_result = bntomew_transliterate(text)
    testing.assert_eq(translit_result.bengali, text)
    testing.assert_eq(translit_result.romanized, "bangladesh dokkhin asiar ekti shadin sarbovum rashtro.")
    testing.assert_eq(bntomew_romanize(text), translit_result.romanized)
}

test bntomew_suffixes_and_fallback {
    testing.assert_eq(bntomew_romanize("বাংলাদেশের"), "bangladesher")
    testing.assert_eq(bntomew_romanize("এশিয়ার"), "asiar")
    testing.assert_eq(bntomew_romanize("স্কুলের"), "schooler")
    testing.assert_eq(bntomew_romanize("Hello 123"), "Hello 123")
    testing.assert_eq(bntomew_romanize("Hello বাংলা World"), "Hello bangla World")
}

test bntomew_controls_digits_and_space {
    testing.assert_eq(bntomew_romanize("বা" + translit_from_codepoint(8204) + "লা"), "bala")
    testing.assert_eq(bntomew_romanize("বাংলা" + translit_from_codepoint(8205)), "bangla")
    testing.assert_eq(bntomew_romanize("রাষ্ট্র।"), "rashtro.")
    testing.assert_eq(bntomew_romanize("রাষ্ট্র॥"), "rashtro.")
    testing.assert_eq(bntomew_romanize("১২৩"), "123")
    testing.assert_eq(bntomew_romanize("৯৯"), "99")
    testing.assert_eq(bntomew_romanize("  বাংলা   ভালো  "), "bangla bhalo")
    var em_space = translit_from_codepoint(8195)
    var spaced = em_space + "বাংলা" + strings.from_char_code(10) + "ভালো" + em_space
    var spaced_result = bntomew_transliterate(spaced)
    testing.assert_eq(spaced_result.bengali, spaced)
    testing.assert_eq(spaced_result.romanized, "bangla bhalo")
    testing.assert_eq(bntomew_romanize("   "), "")
    testing.assert_eq(bntomew_romanize(""), "")
}

test bntomew_unicode_edges {
    var rra = translit_from_codepoint(2524)
    var rha = translit_from_codepoint(2525)
    var yya = translit_from_codepoint(2527)
    testing.assert_eq(bntomew_romanize(rra), "r")
    testing.assert_eq(bntomew_romanize(rha), "rh")
    testing.assert_eq(bntomew_romanize(yya), "y")
    testing.assert_eq(bntomew_romanize(translit_from_codepoint(2511)), "e")
    testing.assert_eq(bntomew_romanize("ৈ"), "oi")
    testing.assert_eq(bntomew_romanize("ঌৄৗঽ়"), "ঌৄৗঽ়")
}

test bntomew_repeated_replacement_and_exception_cleanup {
    var translit_result = bntomew_transliterate("")
    var i = 0
    while (i < 32) {
        translit_result = bntomew_transliterate("আমি ভালো আছি")
        translit_result = bntomew_transliterate("বাংলাদেশের")
        i = i + 1
    }
    testing.assert_eq(translit_result.romanized, "bangladesher")
    try {
        var temporary = bntomew_transliterate("স্কুল")
        if (temporary.romanized != "school") {
            throw "unexpected Bengali result"
        }
        throw "bntomew test exception"
    } catch (err) {
        testing.assert_eq(err, "bntomew test exception")
    }
}
