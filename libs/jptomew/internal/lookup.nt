use strings

fun jptomew_lookup_bucket(view string bucket, view string wanted) -> string {
    var line_start = 0
    var n = strings.length(bucket)
    var newline = strings.from_char_code(10)
    var tab_char = strings.from_char_code(9)
    while (line_start < n) {
        var line_end = strings.index_of(bucket, newline, line_start)
        if (line_end < 0) { line_end = n }
        if (line_end > line_start) {
            var line = strings.substring(bucket, line_start, line_end)
            var tab = strings.index_of(line, tab_char, 0)
            if (tab > 0 && strings.substring(line, 0, tab) == wanted) {
                return strings.substring(line, tab + 1, -1)
            }
        }
        line_start = line_end + 1
    }
    return "~"
}
