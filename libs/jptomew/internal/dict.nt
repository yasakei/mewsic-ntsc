use strings
use arrays
use "../../translit_text.nt"
use "generated/dictionary_00.nt"
use "generated/dictionary_01.nt"
use "generated/dictionary_02.nt"
use "generated/dictionary_03.nt"
use "generated/dictionary_04.nt"
use "generated/dictionary_05.nt"
use "generated/dictionary_06.nt"
use "generated/dictionary_07.nt"
use "generated/dictionary_08.nt"
use "generated/dictionary_09.nt"
use "generated/dictionary_10.nt"
use "generated/dictionary_11.nt"
use "generated/dictionary_12.nt"
use "generated/dictionary_13.nt"
use "generated/dictionary_14.nt"
use "generated/dictionary_15.nt"
use "generated/dictionary_16.nt"
use "generated/dictionary_17.nt"
use "generated/dictionary_18.nt"
use "generated/dictionary_19.nt"
use "generated/dictionary_20.nt"
use "generated/dictionary_21.nt"
use "generated/dictionary_22.nt"
use "generated/dictionary_23.nt"
use "generated/dictionary_24.nt"
use "generated/dictionary_25.nt"
use "generated/dictionary_26.nt"
use "generated/dictionary_27.nt"
use "generated/dictionary_28.nt"
use "generated/dictionary_29.nt"
use "generated/dictionary_30.nt"
use "generated/dictionary_31.nt"

fun jptomew_dictionary(view string key) -> string {
    var hash = 0
    var array[string] chars = translit_chars(key)
    var i = 0
    while (i < arrays.length(chars)) {
        hash = (hash * 131 + translit_codepoint(chars[i])) % 1048576
        i = i + 1
    }
    var bucket = hash % 1024
    if (bucket < 32) { return jptomew_dictionary_0(bucket, key) }
    if (bucket < 64) { return jptomew_dictionary_1(bucket, key) }
    if (bucket < 96) { return jptomew_dictionary_2(bucket, key) }
    if (bucket < 128) { return jptomew_dictionary_3(bucket, key) }
    if (bucket < 160) { return jptomew_dictionary_4(bucket, key) }
    if (bucket < 192) { return jptomew_dictionary_5(bucket, key) }
    if (bucket < 224) { return jptomew_dictionary_6(bucket, key) }
    if (bucket < 256) { return jptomew_dictionary_7(bucket, key) }
    if (bucket < 288) { return jptomew_dictionary_8(bucket, key) }
    if (bucket < 320) { return jptomew_dictionary_9(bucket, key) }
    if (bucket < 352) { return jptomew_dictionary_10(bucket, key) }
    if (bucket < 384) { return jptomew_dictionary_11(bucket, key) }
    if (bucket < 416) { return jptomew_dictionary_12(bucket, key) }
    if (bucket < 448) { return jptomew_dictionary_13(bucket, key) }
    if (bucket < 480) { return jptomew_dictionary_14(bucket, key) }
    if (bucket < 512) { return jptomew_dictionary_15(bucket, key) }
    if (bucket < 544) { return jptomew_dictionary_16(bucket, key) }
    if (bucket < 576) { return jptomew_dictionary_17(bucket, key) }
    if (bucket < 608) { return jptomew_dictionary_18(bucket, key) }
    if (bucket < 640) { return jptomew_dictionary_19(bucket, key) }
    if (bucket < 672) { return jptomew_dictionary_20(bucket, key) }
    if (bucket < 704) { return jptomew_dictionary_21(bucket, key) }
    if (bucket < 736) { return jptomew_dictionary_22(bucket, key) }
    if (bucket < 768) { return jptomew_dictionary_23(bucket, key) }
    if (bucket < 800) { return jptomew_dictionary_24(bucket, key) }
    if (bucket < 832) { return jptomew_dictionary_25(bucket, key) }
    if (bucket < 864) { return jptomew_dictionary_26(bucket, key) }
    if (bucket < 896) { return jptomew_dictionary_27(bucket, key) }
    if (bucket < 928) { return jptomew_dictionary_28(bucket, key) }
    if (bucket < 960) { return jptomew_dictionary_29(bucket, key) }
    if (bucket < 992) { return jptomew_dictionary_30(bucket, key) }
    if (bucket < 1024) { return jptomew_dictionary_31(bucket, key) }
    return "~"
}
