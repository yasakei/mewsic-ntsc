use arrays
use strings
use testing
use "../translit_text.nt"
use "internal/aliases_direct.nt"
use "internal/dict.nt"

enum JptomewJapaneseCheck {
    No,
    Possibly,
    Yes
}
class JptomewTranslitResult {
    var string hiragana
    var string romaji
    fun init(string hira, string latin) {
        this.hiragana = hira
        this.romaji = latin
    }
}

class JptomewRenderState {
    var string buf
    var string result_hira
    var string result_rom
    var int prev_kind
    var bool cap_next
    var bool cap_sent
    var bool cap_sent_done
    fun init() {
        this.buf = ""
        this.result_hira = ""
        this.result_rom = ""
        this.prev_kind = 3
        this.cap_next = false
        this.cap_sent = false
        this.cap_sent_done = false
    }
}

static const var int jptomew_script_hiragana = 0
static const var int jptomew_script_katakana = 1
static const var int jptomew_script_ideograph = 2
static const var int jptomew_script_space = 3
static const var int jptomew_script_leading = 4
static const var int jptomew_script_trailing = 5
static const var int jptomew_script_joining = 6
static const var int jptomew_script_numeric = 7
static const var int jptomew_script_other = 8

fun jptomew_is_ideograph(view string ch) -> bool {
    var code = translit_codepoint(ch)
    return (code >= 19968 && code <= 40879) || (code >= 13312 && code <= 19903)
}

fun jptomew_is_resolvable_ideograph(view string ch) -> bool {
    var code = translit_codepoint(ch)
    return (code >= 19968 && code <= 40959) || (code >= 13312 && code <= 19903)
}

fun jptomew_is_kana(view string ch) -> bool {
    var code = translit_codepoint(ch)
    return (code >= 12353 && code <= 12438) || (code >= 12449 && code <= 12538) || code == 12450
}

fun jptomew_is_fullwidth_punct(view string ch) -> bool {
    var code = translit_codepoint(ch)
    return (code >= 65281 && code <= 65295) || (code >= 65306 && code <= 65311) || (code >= 65339 && code <= 65343) || (code >= 65371 && code <= 65408)
}

fun jptomew_nfkc_char(int code) -> string {
    if (code == 12288) { return " " }
    if (code >= 65281 && code <= 65374) {
        return strings.from_char_code(code - 65248)
    }
    if (code == 9312) { return "1" }
    if (code == 9313) { return "2" }
    if (code == 9314) { return "3" }
    if (code == 9315) { return "4" }
    if (code == 9316) { return "5" }
    if (code == 9317) { return "6" }
    if (code == 9318) { return "7" }
    if (code == 9319) { return "8" }
    if (code == 9320) { return "9" }
    if (code == 9321) { return "10" }
    return ""
}

fun jptomew_normalize(view string text) -> array[string] {
    var array[string] out = arrays.fill("", 0)
    var array[string] input = translit_chars(text)
    var i = 0
    while (i < arrays.length(input)) {
        var string ch = copy(input[i])
        if (translit_codepoint(ch) == 12293) {
            var run = 1
            while (i + run < arrays.length(input) && translit_codepoint(input[i + run]) == 12293) {
                run = run + 1
            }
            var previous = arrays.length(out) - run
            if (previous >= 0) {
                var string repeated = copy(out[previous])
                arrays.push(out, repeated)
            }
            i = i + run
            continue
        }
        var resolved = jptomew_alias(ch)
        if (jptomew_is_fullwidth_punct(ch)) {
            arrays.push(out, copy(resolved))
        } else {
            var expanded = jptomew_nfkc_char(translit_codepoint(resolved))
            if (expanded == "") {
                arrays.push(out, copy(resolved))
            } else {
                var array[string] expanded_chars = translit_chars(expanded)
                var j = 0
                while (j < arrays.length(expanded_chars)) {
                    arrays.push(out, copy(expanded_chars[j]))
                    j = j + 1
                }
            }
        }
        i = i + 1
    }
    return out
}

fun jptomew_classify(view string ch) -> int {
    var code = translit_codepoint(ch)
    if (code >= 12353 && code <= 12438) { return jptomew_script_hiragana }
    if ((code >= 12449 && code <= 12538) || code == 12450) { return jptomew_script_katakana }
    if ((code >= 19968 && code <= 40879) || (code >= 13312 && code <= 19903)) { return jptomew_script_ideograph }
    if (code == 12540) { return jptomew_script_katakana }
    if (translit_is_space(ch)) { return jptomew_script_space }
    if (ch == "・") { return jptomew_script_space }
    if (ch == "「" || ch == "『" || ch == "〈" || ch == "《" || ch == "【" || ch == "〔" || ch == "〖" || ch == "〘" || ch == "〝" || ch == "＃" || ch == "（" || ch == "［" || ch == "｛") {
        return jptomew_script_leading
    }
    if (ch == "。" || ch == "、" || ch == "」" || ch == "』" || ch == "〉" || ch == "》" || ch == "】" || ch == "〕" || ch == "〗" || ch == "〙" || ch == "〟" || ch == "：" || ch == "；" || ch == "！" || ch == "？" || ch == "）" || ch == "］" || ch == "｝") {
        return jptomew_script_trailing
    }
    if (ch == "〜" || ch == "＿" || ch == "(" || ch == "[" || ch == "{" || ch == "_") {
        return jptomew_script_joining
    }
    if (code >= 48 && code <= 57) { return jptomew_script_numeric }
    if (ch == "." || ch == ",") { return jptomew_script_other }
    if (ch == ":" || ch == ";" || ch == "!" || ch == "?" || ch == "#" || ch == ")" || ch == "]" || ch == "}") {
        return jptomew_script_trailing
    }
    return jptomew_script_other
}

fun jptomew_is_japanese_punct(view string ch) -> bool {
    return ch == "、" || ch == "。" || ch == "「" || ch == "」" || ch == "『" || ch == "』" || ch == "〜" || ch == "・" || ch == "〈" || ch == "〉" || ch == "《" || ch == "》" || ch == "【" || ch == "〔" || ch == "〗" || ch == "〖" || ch == "〘" || ch == "〙" || ch == "〝" || ch == "〟" || ch == "：" || ch == "；" || ch == "！" || ch == "？" || ch == "＃" || ch == "）" || ch == "］" || ch == "｝" || ch == "（" || ch == "［" || ch == "｛"
}

fun jptomew_kind_after(int kind) -> bool {
    return kind != jptomew_script_leading && kind != jptomew_script_joining
}

fun jptomew_kind_before(int kind) -> bool {
    return kind != jptomew_script_trailing && kind != jptomew_script_joining
}

fun jptomew_kind_is_japanese(int kind) -> bool {
    return kind == jptomew_script_hiragana || kind == jptomew_script_katakana || kind == jptomew_script_ideograph
}

fun jptomew_punct_to_latin(view string ch) -> string {
    if (ch == "、") { return "," }
    if (ch == "。") { return "." }
    if (ch == "「" || ch == "」" || ch == "』" || ch == "〝" || ch == "〟" || ch == "『") { return strings.from_char_code(34) }
    if (ch == "〈") { return "<" }
    if (ch == "〉") { return ">" }
    if (ch == "《") { return "«" }
    if (ch == "》") { return "»" }
    if (ch == "【" || ch == "〖") { return "[" }
    if (ch == "】" || ch == "〗") { return "]" }
    if (ch == "〔" || ch == "〘" || ch == "（") { return "(" }
    if (ch == "〕" || ch == "〙" || ch == "）") { return ")" }
    if (ch == "〜") { return "~" }
    if (ch == "：") { return ":" }
    if (ch == "；") { return ";" }
    if (ch == "！") { return "!" }
    if (ch == "？") { return "?" }
    if (ch == "＃") { return "#" }
    if (ch == "［") { return "[" }
    if (ch == "］") { return "]" }
    if (ch == "｛") { return "{" }
    if (ch == "｝") { return "}" }
    return ""
}

fun jptomew_triggers_capitalization(view string ch) -> bool {
    return ch == "." || ch == "!" || ch == "?"
}

fun jptomew_manage_trailing_space(view string text, bool want_space) -> string {
    if (text == "" || strings.ends_with(text, "\n")) { return copy(text) }
    if (strings.ends_with(text, " ")) {
        if (!want_space) { return strings.substring(text, 0, strings.length(text) - 1) }
        return copy(text)
    }
    if (want_space) { return copy(text) + " " }
    return copy(text)
}

fun jptomew_alphanumeric(int code) -> bool {
    return (code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122)
}

fun jptomew_capitalize_first(view string text) -> string {
    var array[string] chars = translit_chars(text)
    var out = ""
    var changed = false
    var i = 0
    while (i < arrays.length(chars)) {
        var string ch = copy(chars[i])
        if (!changed && jptomew_alphanumeric(translit_codepoint(ch))) {
            var code = translit_codepoint(ch)
            if (jptomew_alphanumeric(code) && code >= 97 && code <= 122) { ch = strings.upper(ch) }
            changed = true
        }
        out = out + ch
        i = i + 1
    }
    return out
}

