fun jptomew_last_vowel(view string text) -> string {
    var i = strings.length(text) - 1
    while (i >= 0) {
        var c = strings.char_at(text, i)
        if (c == "a" || c == "e" || c == "i" || c == "o" || c == "u") { return c }
        i = i - 1
    }
    return ""
}

fun jptomew_kana_romaji(view string text) -> string {
    var hira = jptomew_to_hiragana(text)
    var array[string] chars = translit_chars(hira)
    var out = ""
    var last_vowel = ""
    var i = 0
    while (i < arrays.length(chars)) {
        var string ch = copy(chars[i])
        if (ch == "ー") {
            out = out + last_vowel
            i = i + 1
            continue
        }
        if (i + 1 < arrays.length(chars)) {
            var combo = jptomew_combined(ch, chars[i + 1])
            if (combo != "") {
                out = out + combo
                last_vowel = jptomew_last_vowel(combo)
                i = i + 2
                continue
            }
        }
        if (ch == "っ") {
            if (i + 1 < arrays.length(chars)) {
                var next_rom = jptomew_single(chars[i + 1])
                if (next_rom != "") {
                    out = out + strings.substring(next_rom, 0, 1)
                    i = i + 1
                    continue
                }
            }
            out = out + "tsu"
            i = i + 1
            continue
        }
        if (ch == "ん") {
            var apostrophe = false
            if (i + 1 < arrays.length(chars)) {
                var next_rom = jptomew_single(chars[i + 1])
                if (next_rom != "") {
                    var first = strings.substring(next_rom, 0, 1)
                    apostrophe = first == "a" || first == "e" || first == "i" || first == "o" || first == "u" || first == "y"
                }
            }
            if (apostrophe) { out = out + "n'" } else { out = out + "n" }
            i = i + 1
            continue
        }
        var rom = jptomew_single(ch)
        if (rom == "") {
            out = out + ch
        } else {
            out = out + rom
            last_vowel = jptomew_last_vowel(rom)
        }
        i = i + 1
    }
    return out
}

fun jptomew_spans_kana(view array[string] chars, int start, int count) -> bool {
    var i = start
    while (i < start + count) {
        if (!jptomew_is_resolvable_ideograph(chars[i])) { return true }
        i = i + 1
    }
    return false
}

fun jptomew_tail_matches(view string tail, view string next) -> bool {
    if (tail == "a") { return strings.contains("あぁっわゎ", next) }
    if (tail == "i") { return strings.contains("いぃっゐ", next) }
    if (tail == "u") { return strings.contains("うぅっ", next) }
    if (tail == "e") { return strings.contains("えぇっゑ", next) }
    if (tail == "o") { return strings.contains("おぉっ", next) }
    if (tail == "k") { return strings.contains("かゕきくけゖこっ", next) }
    if (tail == "g") { return strings.contains("がぎぐげごっ", next) }
    if (tail == "s") { return strings.contains("さしすせそっ", next) }
    if (tail == "z" || tail == "j") { return strings.contains("ざじずぜぞっ", next) }
    if (tail == "t") { return strings.contains("たちつてとっ", next) }
    if (tail == "d") { return strings.contains("だぢづでどっ", next) }
    if (tail == "c") { return strings.contains("ちっ", next) }
    if (tail == "n") { return strings.contains("なにぬねのん", next) }
    if (tail == "h") { return strings.contains("はひふへほっ", next) }
    if (tail == "b") { return strings.contains("ばびぶべぼっ", next) }
    if (tail == "f") { return strings.contains("ふっ", next) }
    if (tail == "p") { return strings.contains("ぱぴぷぺぽっ", next) }
    if (tail == "m") { return strings.contains("まみむめも", next) }
    if (tail == "y") { return strings.contains("ゃやゅゆょよ", next) }
    if (tail == "r") { return strings.contains("らりるれろ", next) }
    if (tail == "w") { return strings.contains("わゐゑゎをっ", next) }
    if (tail == "v") { return next == "ゔ" }
    return false
}

fun jptomew_choose(view array[string] chars, int start, int count, view string before, view string records) -> (bool, string, int, bool) {
    if (records == "~" || records == "E||") { return (false, "", 0, false) }
    var ordinal = 0
    var at = 0
    while (at <= strings.length(records)) {
        var end = strings.index_of(records, ";", at)
        if (end < 0) { end = strings.length(records) }
        var record = strings.substring(records, at, end)
        var first = strings.index_of(record, "|", 0)
        var second = strings.index_of(record, "|", first + 1)
        var kind = strings.substring(record, 0, first)
        var hira = strings.substring(record, first + 1, second)
        var extra = strings.substring(record, second + 1, -1)
        if (kind == "C") {
            if (start + count < arrays.length(chars) && jptomew_tail_matches(extra, chars[start + count])) {
                return (true, hira + chars[start + count], count + 1, true)
            }
        } else if (kind == "X") {
            if (strings.contains(before, extra)) { return (true, hira, count, jptomew_spans_kana(chars, start, count)) }
        } else if (kind == "P") {
            return (true, hira, count, jptomew_spans_kana(chars, start, count))
        }
        if (end >= strings.length(records)) { break }
        at = end + 1
        ordinal = ordinal + 1
    }
    return (false, "", 0, false)
}

fun jptomew_resolve(view array[string] chars, int start, view string before) -> (bool, string, int, bool) {
    var best_found = false
    var best_hira = ""
    var best_count = 0
    var best_continues = false
    var key = ""
    var count = 0
    while (start + count < arrays.length(chars) && count < 8) {
        key = key + chars[start + count]
        count = count + 1
        var records = jptomew_dictionary(key)
        if (records == "~") { break }
        var (found, hira, consumed, continues) = jptomew_choose(chars, start, count, before, records)
        if (found) {
            best_found = true
            best_hira = hira
            best_count = consumed
            best_continues = continues
        }
    }
    return (best_found, best_hira, best_count, best_continues)
}

fun jptomew_flush(view mut JptomewRenderState state) {
    if (state.buf == "") {
        return
    }
    var hira = jptomew_to_hiragana(state.buf)
    state.result_hira = copy(state.result_hira) + hira
    var rom = jptomew_kana_romaji(hira)
    if (state.cap_next) {
        rom = jptomew_capitalize_first(rom)
        state.cap_next = false
    }
    if (state.cap_sent && !state.cap_sent_done) {
        state.result_rom = jptomew_capitalize_first(state.result_rom)
        state.cap_sent_done = true
    }
    state.result_rom = jptomew_manage_trailing_space(state.result_rom, jptomew_kind_after(state.prev_kind))
    state.result_rom = copy(state.result_rom) + rom
    state.buf = ""
    state.prev_kind = jptomew_script_hiragana
}

fun jptomew_transliterate(view string text) -> JptomewTranslitResult {
    var array[string] chars = jptomew_normalize(text)
    var JptomewRenderState state = JptomewRenderState()
    var i = 0
    while (i < arrays.length(chars)) {
        var string ch = copy(chars[i])
        var kind = jptomew_classify(ch)
        if (kind == jptomew_script_hiragana || kind == jptomew_script_katakana) {
            state.buf = copy(state.buf) + ch
            i = i + 1
            continue
        }
        if (kind == jptomew_script_ideograph) {
            var (found, hira, consumed, continues) = jptomew_resolve(chars, i, state.buf)
            jptomew_flush(state)
            if (found) {
                state.buf = copy(state.buf) + hira
                if (!continues) { jptomew_flush(state) }
                i = i + consumed
            } else {
                state.result_hira = copy(state.result_hira) + ch
                state.result_rom = copy(state.result_rom) + ch
                state.prev_kind = jptomew_script_ideograph
                i = i + 1
            }
            continue
        }
        if (kind == jptomew_script_space) {
            jptomew_flush(state)
            state.result_hira = copy(state.result_hira) + ch
            if (ch == "・") { state.result_rom = copy(state.result_rom) + " " } else { state.result_rom = copy(state.result_rom) + ch }
            state.prev_kind = jptomew_script_space
            i = i + 1
            continue
        }
        jptomew_flush(state)
        state.result_hira = copy(state.result_hira) + ch
        var jp = jptomew_is_japanese_punct(ch)
        if (jptomew_kind_is_japanese(state.prev_kind) || jp) {
            state.result_rom = jptomew_manage_trailing_space(state.result_rom, jptomew_kind_after(state.prev_kind) && jptomew_kind_before(kind))
        }
        var latin = jptomew_punct_to_latin(ch)
        if (jp && kind == jptomew_script_other) {
            state.result_rom = copy(state.result_rom) + jptomew_nfkc_char(translit_codepoint(ch))
        } else if (latin != "") {
            state.result_rom = copy(state.result_rom) + latin
            var first = strings.substring(latin, 0, 1)
            if (jptomew_triggers_capitalization(first) && kind != jptomew_script_joining) {
                state.cap_next = true
                state.cap_sent = true
            }
        } else {
            state.result_rom = copy(state.result_rom) + ch
        }
        state.prev_kind = kind
        i = i + 1
    }
    jptomew_flush(state)
    return JptomewTranslitResult(copy(state.result_hira), copy(state.result_rom))
}

fun jptomew_romaji(view string text) -> string {
    var JptomewTranslitResult r = jptomew_transliterate(text)
    return r.romaji
}

fun jptomew_hiragana(view string text) -> string {
    var JptomewTranslitResult r = jptomew_transliterate(text)
    return r.hiragana
}

fun jptomew_detect(view string text) -> int {
    var array[string] chars = translit_chars(text)
    for (var ch in chars) {
        var code = translit_codepoint(ch)
        if ((code >= 12353 && code <= 12438) || (code >= 12449 && code <= 12538)) { return JptomewJapaneseCheck.Yes }
        if (code >= 19968 && code <= 40879) { return JptomewJapaneseCheck.Possibly }
    }
    return JptomewJapaneseCheck.No
}

fun jptomew_is_japanese(view string text) -> bool {
    return jptomew_detect(text) != JptomewJapaneseCheck.No
}

test jptomew_transliterate_sentence {
    var JptomewTranslitResult r = jptomew_transliterate("こんにちは世界!")
    testing.assert_true(r.hiragana == "こんにちはせかい!")
    testing.assert_true(r.romaji == "konnichiha sekai!")
}

test jptomew_katakana_and_kana_rules {
    testing.assert_true(jptomew_hiragana("カタカナ") == "かたかな")
    testing.assert_true(jptomew_romaji("カタカナ") == "katakana")
    testing.assert_true(jptomew_romaji("きって がっこう んあ んや") == "kitte gakkou n'a n'ya")
    testing.assert_true(jptomew_romaji("ばー こーひ") == "baa koohi")
}

test jptomew_dictionary_and_okurigana {
    testing.assert_true(jptomew_hiragana("渋谷") == "しぶや")
    testing.assert_true(jptomew_romaji("渋谷で待ってる") == "shibuya de matteru")
    testing.assert_true(jptomew_romaji("こんにちは世界!") == "konnichiha sekai!")
}

test jptomew_detection {
    testing.assert_true(jptomew_detect("Hello") == JptomewJapaneseCheck.No)
    testing.assert_true(jptomew_detect("日本") == JptomewJapaneseCheck.Possibly)
    testing.assert_true(jptomew_detect("ひらがな") == JptomewJapaneseCheck.Yes)
    testing.assert_true(jptomew_detect("カタカナ") == JptomewJapaneseCheck.Yes)
    testing.assert_true(!jptomew_is_japanese("ー"))
}

test jptomew_normalization_repetition_and_aliases {
    testing.assert_true(jptomew_hiragana("人々") == "人人")
    testing.assert_true(jptomew_hiragana("人々人") == "人人人")
    testing.assert_true(jptomew_hiragana("々") == "")
    testing.assert_true(jptomew_hiragana("藥") == "薬")
    testing.assert_true(jptomew_hiragana("ＡＢＣ ①") == "ABC 1")
    testing.assert_true(jptomew_hiragana("！") == "！")
}

test jptomew_punctuation_spacing_and_fallback {
    testing.assert_true(jptomew_romaji("Hello 123") == "Hello 123")
    testing.assert_true(jptomew_romaji("日本。次") == "Nihon. Tsugi")
    testing.assert_true(jptomew_romaji("「日本」") == "\"Nihon\"")
    testing.assert_true(jptomew_romaji("⿿") == "⿿")
    testing.assert_true(jptomew_hiragana("") == "")
}
