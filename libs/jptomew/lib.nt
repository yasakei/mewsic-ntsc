fun jptomew_to_hiragana(view string text) -> string {
    var array[string] chars = translit_chars(text)
    var out = ""
    for (var ch in chars) { out = out + jptomew_kata_to_hira_char(ch) }
    return out
}

fun jptomew_combined(view string a, view string b) -> string {
    if (a == "き" && b == "ゃ") { return "kya" }
    if (a == "き" && b == "ゅ") { return "kyu" }
    if (a == "き" && b == "ょ") { return "kyo" }
    if (a == "ぎ" && b == "ゃ") { return "gya" }
